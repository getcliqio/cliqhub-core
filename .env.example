# CliqHub Core — environment variables
#
# Every variable Core reads (src/config/env.ts and the rest of src/).
# Placeholder values only: never commit real keys, passwords or database
# credentials. Unset optional variables take the default shown.

# ── Server ─────────────────────────────────────────────────────────────
# Runtime mode. "production" makes TOKEN_ENCRYPTION_KEY, PUBLIC_APP_URL and the bootstrap admin (empty DB) required. Optional, default: development
NODE_ENV=development
# HTTP port (Core binds to ::). Optional, default: 4000
PORT=4000
# Comma-separated CORS origins allowed to call Core. Optional, default: empty (no CORS headers)
ALLOWED_ORIGINS=http://localhost:5173
# Log level: debug | info | warn | error | fatal. Optional, default: info (CLIQ_HUB_LOG_LEVEL wins over LOG_LEVEL)
LOG_LEVEL=info
# Same as LOG_LEVEL, takes precedence when both are set. Optional, default: unset
# CLIQ_HUB_LOG_LEVEL=info
# Log every SQL statement when "1". Optional, default: off
# SEQUELIZE_LOG=1

# ── Database ───────────────────────────────────────────────────────────
# Postgres connection URL. Required.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/cliqhub
# Skip the one-off UUID re-mint migration at boot when "1". Optional, default: off
# CLIQHUB_SKIP_UUID_REMINT=1

# ── Auth and sessions ──────────────────────────────────────────────────
# Secret for signing JWTs. Optional outside production (a dev-only default is used); set a long random value in every real deployment.
JWT_SECRET=change-me-to-a-long-random-string
# JWT lifetime. Optional, default: 12h
JWT_EXPIRES_IN=12h
# Allow personal access tokens to perform daemon writes; "0" / "false" / "off" disables. Optional, default: allowed
# ALLOW_PAT_DAEMON_WRITES=1
# Ignored (the route policy is always enforced; Core logs a warning when it is set). Do not set.
# ROUTE_POLICY_MODE=

# ── Bootstrap admin (only used when the database has no user yet) ─────
# Username of the first site admin. Required in production on an empty database, otherwise optional.
CLIQ_BOOTSTRAP_ADMIN_USER=admin-user
# Password of the first site admin (at least 8 characters). Required with CLIQ_BOOTSTRAP_ADMIN_USER.
CLIQ_BOOTSTRAP_ADMIN_PASSWORD=change-me-please
# Email of the first site admin. Optional, default: <user>@cliqhub.local
# CLIQ_BOOTSTRAP_ADMIN_EMAIL=admin@example.test

# ── Identity links and email ───────────────────────────────────────────
# Key that encrypts stored invite / set-password / reset links: 32 bytes as 64 hex characters or base64.
# Generate with `openssl rand -base64 32` (or `openssl rand -hex 32`). Required in production; validated when set elsewhere.
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_base64_32
# Base URL of the web app (no trailing slash): email links (/invite/<token>, /reset/<token>) point here.
# Must be http(s). Required in production; validated when set elsewhere.
PUBLIC_APP_URL=http://localhost:5173
# Brevo transactional email API key. Optional: without it no email is sent and responses return the link (invite_url / setup_url / reset_url) instead.
BREVO_API_KEY=
# Or send over SMTP instead of the API. Brevo: SMTP & API → SMTP — the login and an SMTP key (xsmtpsib-…).
SMTP_USER=
SMTP_PASS=
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# Sender address for all email. Required when BREVO_API_KEY or SMTP_USER is set.
EMAIL_FROM_ADDRESS=noreply@example.test
# Sender display name. Optional, default: CliqHub
EMAIL_FROM_NAME=CliqHub

# ── Public URLs (A2A / agent cards / review links) ─────────────────────
# Public base URL of the Core API for A2A and agent cards. Optional, default: CLIQHUB_PUBLIC_URL, then https://api.cliqhub.io
# CLIQHUB_PUBLIC_API_URL=https://api.example.test
# Public base URL of CliqHub (fallback for the above and for review links). Optional, default: https://api.cliqhub.io (A2A)
# CLIQHUB_PUBLIC_URL=https://app.example.test

# ── Rate limits (HTTP) ─────────────────────────────────────────────────
# Requests per window for public routes. Optional, default: 30
RATE_LIMIT_PUBLIC_RPM=30
# Requests per window for auth routes. Optional, default: 120
RATE_LIMIT_AUTH_RPM=120
# Rate limit window in ms. Optional, default: 60000
RATE_LIMIT_WINDOW_MS=60000

# ── Storage (team packages and run artifacts) ──────────────────────────
# "local" (filesystem) or "r2" (S3-compatible). Optional, default: local
STORAGE_BACKEND=local
# Directory for team packages with local storage. Optional, default: ./data/packages
PACKAGES_PATH=./data/packages
# S3 / R2 endpoint URL. Required with STORAGE_BACKEND=r2 (and for artifact storage), otherwise optional.
S3_ENDPOINT=
# Bucket for team packages. Optional, default: cliqhub-packages
S3_TEAMS_BUCKET=cliqhub-packages
# Bucket for run artifacts. Optional, default: cliq-artifacts
S3_ARTIFACTS_BUCKET=cliq-artifacts
# S3 / R2 access key id. Required with S3 storage.
S3_ACCESS_KEY_ID=
# S3 / R2 secret access key. Required with S3 storage.
S3_SECRET_ACCESS_KEY=
# Largest artifact upload in MB. Optional, default: 50
# CLIQ_ARTIFACT_MAX_MB=50

# ── Team builder (LLM) ─────────────────────────────────────────────────
# Gemini API key for the hosted team builder. Optional: without it builder requests fail (Core logs an error at boot).
GEMINI_API_KEY=
# Builder model name. Optional, default: gemini-3.6-flash
# BUILDER_MODEL=gemini-3.6-flash

# ── Integrations ───────────────────────────────────────────────────────
# Enable the Jira integration when "1". Optional, default: off
# ENABLE_JIRA_INTEGRATION=1

# ── Background jobs (all optional; defaults shown) ─────────────────────
# How often the run reaper runs, ms. Default: 60000
# RUN_REAPER_INTERVAL_MS=60000
# A daemon silent this long is stale, ms. Default: 90000
# DAEMON_STALE_THRESHOLD_MS=90000
# Run lease TTL, ms. Default: 3600000 (1 hour)
# RUN_LEASE_TTL_MS=3600000
# Lease TTL of a run awaiting input, ms. Default: 86400000 (24 hours)
# RUN_LEASE_AWAITING_TTL_MS=86400000
# How often the review expiry sweep runs, ms. Default: 60000
# REVIEW_EXPIRY_SWEEP_MS=60000
# Days webhook delivery records are kept. Default: 30
# WEBHOOK_DELIVERY_RETENTION_DAYS=30
# How often old webhook deliveries are pruned, ms. Default: 86400000 (24 hours)
# WEBHOOK_DELIVERY_RETENTION_INTERVAL_MS=86400000

# ── Tests only (read by the test suite, not by the server) ─────────────
# Dedicated test database. Optional, default: postgresql://…@localhost:5432/cliqhub_test (created if missing when the role has CREATEDB).
# Tests refuse the dev database "cliqhub". Never point this at a shared or production database.
CLIQHUB_TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/cliqhub_test
