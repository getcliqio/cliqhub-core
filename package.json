{
    "name": "@getcliqio/cliqhub-core",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "tsc && npm run copy-data",
        "copy-data": "mkdir -p dist/data src/data && find src/data -maxdepth 1 -name \"*.json\" -exec cp {} dist/data/ \\; || true",
        "start": "node dist/server.js",
        "dev": "tsc --watch & node --env-file=.env --watch dist/server.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "engines": {
        "node": ">=20"
    },
    "dependencies": {
        "@faker-js/faker": "^9.9.0",
        "@getcliqio/cliq-store": "1.9.2",
        "@google/adk": "^1.1.0",
        "@svantic/sdk": "^1.8.3",
        "bcrypt": "^6.0.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "express": "^5.1.0",
        "helmet": "^8.1.0",
        "jose": "^5.10.0",
        "js-yaml": "^4.1.0",
        "jsonwebtoken": "^9.0.2",
        "jszip": "^3.10.1",
        "pg": "^8.16.0",
        "sequelize": "^6.37.8",
        "sequelize-typescript": "^2.1.6",
        "uuid": "^11.1.0",
        "ws": "^8.21.3",
        "zod": "^3.24.4"
    },
    "devDependencies": {
        "@types/bcrypt": "^5.0.2",
        "@types/cookie-parser": "^1.4.8",
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.2",
        "@types/js-yaml": "^4.0.9",
        "@types/jsonwebtoken": "^9.0.9",
        "@types/node": "^22.0.0",
        "@types/pg": "^8.11.0",
        "@types/supertest": "^6.0.2",
        "@types/uuid": "^10.0.0",
        "@types/ws": "^8.18.1",
        "@vitest/coverage-v8": "^3.1.3",
        "supertest": "^7.1.0",
        "typescript": "^5.8.3",
        "vitest": "^3.1.3"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/getcliqio/cliqhub-core.git"
    }
}
